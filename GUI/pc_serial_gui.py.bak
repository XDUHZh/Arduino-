"""Arduino 距离测量 PC 上位机。"""

from __future__ import annotations

import json
import queue
import threading
import tkinter as tk
from datetime import datetime
from pathlib import Path
from tkinter import messagebox, ttk

try:
    import serial
    from serial.tools import list_ports
except ImportError:  # 允许在未安装 pyserial 时先预览界面
    serial = None
    list_ports = None

from serial_protocol import make_command, parse_distance


APP_DIR = Path(__file__).resolve().parent
CONFIG_FILE = APP_DIR / "student_config.json"
DEFAULT_CONFIG = {"student_id": "请输入学号", "student_name": "请输入姓名"}
BAUD_RATES = (9600, 19200, 38400, 57600, 115200)


class SerialWorker:
    """在后台线程中读取串口，并通过队列把数据交给 GUI。"""

    def __init__(self, inbox: queue.Queue[tuple[str, object]]) -> None:
        self.inbox = inbox
        self.connection = None
        self._thread: threading.Thread | None = None
        self._stop_event = threading.Event()

    @property
    def is_open(self) -> bool:
        return bool(self.connection and self.connection.is_open)

    def open(self, port: str, baudrate: int) -> None:
        if serial is None:
            raise RuntimeError("未安装 pyserial，请先执行：pip install -r requirements.txt")
        self.connection = serial.Serial(port, baudrate, timeout=0.2)
        self._stop_event.clear()
        self._thread = threading.Thread(target=self._read_loop, daemon=True)
        self._thread.start()

    def close(self) -> None:
        self._stop_event.set()
        connection = self.connection
        self.connection = None
        if connection and connection.is_open:
            connection.close()

    def send(self, payload: bytes) -> None:
        if not self.is_open:
            raise RuntimeError("请先打开串口")
        self.connection.write(payload)

    def _read_loop(self) -> None:
        while not self._stop_event.is_set():
            connection = self.connection
            if not connection or not connection.is_open:
                break
            try:
                raw = connection.readline()
                if raw:
                    self.inbox.put(("data", raw.decode("utf-8", errors="replace").strip()))
            except (serial.SerialException, OSError) as exc:
                if not self._stop_event.is_set():
                    self.inbox.put(("error", str(exc)))
                break


class ArduinoSerialApp(tk.Tk):
    POLL_INTERVAL_MS = 80

    def __init__(self) -> None:
        super().__init__()
        self.config_data = self._load_config()
        self.inbox: queue.Queue[tuple[str, object]] = queue.Queue()
        self.worker = SerialWorker(self.inbox)

        self.student_id_var = tk.StringVar(value=self.config_data["student_id"])
        self.student_name_var = tk.StringVar(value=self.config_data["student_name"])
        self.port_var = tk.StringVar()
        self.baud_var = tk.StringVar(value="9600")
        self.status_var = tk.StringVar(value="串口未连接")
        self.distance_var = tk.StringVar(value="--.- cm")

        self._configure_window()
        self._build_styles()
        self._build_ui()
        self.refresh_ports()
        self.after(self.POLL_INTERVAL_MS, self._process_inbox)
        self.protocol("WM_DELETE_WINDOW", self._on_close)

    def _configure_window(self) -> None:
        self.title(self._window_title())
        self.geometry("980x680")
        self.minsize(820, 580)
        self.configure(bg="#eef3f8")

    def _window_title(self) -> str:
        return f"Arduino 距离测量上位机 - {self.config_data['student_id']} - {self.config_data['student_name']}"

    def _build_styles(self) -> None:
        style = ttk.Style(self)
        style.theme_use("clam")
        style.configure("TFrame", background="#eef3f8")
        style.configure("Card.TFrame", background="#ffffff")
        style.configure("TLabel", background="#eef3f8", foreground="#203247", font=("Microsoft YaHei UI", 10))
        style.configure("Card.TLabel", background="#ffffff", foreground="#203247", font=("Microsoft YaHei UI", 10))
        style.configure("Header.TLabel", background="#16324f", foreground="#ffffff", font=("Microsoft YaHei UI", 19, "bold"))
        style.configure("SubHeader.TLabel", background="#16324f", foreground="#b8d4ec", font=("Microsoft YaHei UI", 10))
        style.configure("Section.TLabel", background="#ffffff", foreground="#16324f", font=("Microsoft YaHei UI", 12, "bold"))
        style.configure("Distance.TLabel", background="#ffffff", foreground="#0f8b8d", font=("Consolas", 34, "bold"))
        style.configure("Accent.TButton", font=("Microsoft YaHei UI", 10, "bold"), padding=(14, 8), background="#0f8b8d", foreground="#ffffff")
        style.map("Accent.TButton", background=[("active", "#0c7476"), ("disabled", "#a9b9bd")])
        style.configure("TButton", font=("Microsoft YaHei UI", 10), padding=(10, 7))
        style.configure("TEntry", padding=6)
        style.configure("TCombobox", padding=5)

    def _build_ui(self) -> None:
        header = tk.Frame(self, bg="#16324f", height=92)
        header.pack(fill="x")
        header.pack_propagate(False)
        ttk.Label(header, text="Arduino 距离测量上位机", style="Header.TLabel").pack(anchor="w", padx=28, pady=(17, 0))
        self.header_identity = ttk.Label(header, text=self._identity_text(), style="SubHeader.TLabel")
        self.header_identity.pack(anchor="w", padx=30, pady=(3, 0))

        body = ttk.Frame(self, padding=18)
        body.pack(fill="both", expand=True)
        body.columnconfigure(0, weight=1)
        body.columnconfigure(1, weight=1)
        body.rowconfigure(2, weight=1)

        self._build_identity_card(body)
        self._build_serial_card(body)
        self._build_send_card(body)
        self._build_receive_card(body)
        self._build_status_bar()

    def _card(self, parent: ttk.Frame, title: str, row: int, column: int, **grid_options: object) -> ttk.Frame:
        card = ttk.Frame(parent, style="Card.TFrame", padding=16)
        card.grid(row=row, column=column, sticky="nsew", padx=6, pady=6, **grid_options)
        ttk.Label(card, text=title, style="Section.TLabel").pack(anchor="w", pady=(0, 12))
        return card

    def _build_identity_card(self, parent: ttk.Frame) -> None:
        card = self._card(parent, "学生信息", 0, 0)
        form = ttk.Frame(card, style="Card.TFrame")
        form.pack(fill="x")
        form.columnconfigure(1, weight=1)
        ttk.Label(form, text="学号", style="Card.TLabel").grid(row=0, column=0, sticky="w", padx=(0, 8), pady=5)
        ttk.Entry(form, textvariable=self.student_id_var).grid(row=0, column=1, sticky="ew", pady=5)
        ttk.Label(form, text="姓名", style="Card.TLabel").grid(row=1, column=0, sticky="w", padx=(0, 8), pady=5)
        ttk.Entry(form, textvariable=self.student_name_var).grid(row=1, column=1, sticky="ew", pady=5)
        ttk.Button(form, text="保存并更新标题", command=self.save_identity).grid(row=2, column=1, sticky="e", pady=(8, 0))

    def _build_serial_card(self, parent: ttk.Frame) -> None:
        card = self._card(parent, "串口连接", 0, 1)
        row = ttk.Frame(card, style="Card.TFrame")
        row.pack(fill="x")
        row.columnconfigure(1, weight=1)
        ttk.Label(row, text="串口", style="Card.TLabel").grid(row=0, column=0, sticky="w", padx=(0, 8), pady=5)
        self.port_box = ttk.Combobox(row, textvariable=self.port_var, state="readonly")
        self.port_box.grid(row=0, column=1, sticky="ew", pady=5)
        ttk.Button(row, text="刷新", command=self.refresh_ports).grid(row=0, column=2, padx=(8, 0))
        ttk.Label(row, text="波特率", style="Card.TLabel").grid(row=1, column=0, sticky="w", padx=(0, 8), pady=5)
        ttk.Combobox(row, textvariable=self.baud_var, values=BAUD_RATES, state="readonly", width=12).grid(row=1, column=1, sticky="w", pady=5)
        self.connection_button = ttk.Button(row, text="打开串口", style="Accent.TButton", command=self.toggle_connection)
        self.connection_button.grid(row=2, column=1, sticky="ew", pady=(9, 0))

    def _build_send_card(self, parent: ttk.Frame) -> None:
        card = self._card(parent, "发送窗口（学号及控制命令）", 1, 0, columnspan=2)
        controls = ttk.Frame(card, style="Card.TFrame")
        controls.pack(fill="x", pady=(0, 10))
        self.send_id_button = ttk.Button(controls, text="发送学号", style="Accent.TButton", command=self.send_student_id)
        self.send_id_button.pack(side="left", padx=(0, 8))
        ttk.Button(controls, text="单次测距", command=lambda: self.send_command("MEASURE", "单次测距")).pack(side="left", padx=4)
        ttk.Button(controls, text="开始连续测量", command=lambda: self.send_command("START", "开始连续测量")).pack(side="left", padx=4)
        ttk.Button(controls, text="停止连续测量", command=lambda: self.send_command("STOP", "停止连续测量")).pack(side="left", padx=4)
        ttk.Button(controls, text="清空发送记录", command=lambda: self._clear_text(self.send_text)).pack(side="right")
        self.send_text = self._make_text_area(card, height=6)
        self._append_log(self.send_text, f"待发送学号：{self.student_id_var.get()}")

    def _build_receive_card(self, parent: ttk.Frame) -> None:
        card = self._card(parent, "接收窗口（距离值）", 2, 0, columnspan=2)
        top = ttk.Frame(card, style="Card.TFrame")
        top.pack(fill="x", pady=(0, 8))
        ttk.Label(top, text="当前距离", style="Card.TLabel").pack(side="left")
        ttk.Label(top, textvariable=self.distance_var, style="Distance.TLabel").pack(side="left", padx=20)
        ttk.Button(top, text="清空接收记录", command=lambda: self._clear_text(self.receive_text)).pack(side="right")
        self.receive_text = self._make_text_area(card, height=10)

    def _build_status_bar(self) -> None:
        bar = tk.Frame(self, bg="#dce6ef", height=34)
        bar.pack(fill="x", side="bottom")
        self.status_dot = tk.Label(bar, text="●", bg="#dce6ef", fg="#8b99a8", font=("Arial", 11))
        self.status_dot.pack(side="left", padx=(18, 6))
        tk.Label(bar, textvariable=self.status_var, bg="#dce6ef", fg="#34495e", font=("Microsoft YaHei UI", 9)).pack(side="left")

    @staticmethod
    def _make_text_area(parent: ttk.Frame, height: int) -> tk.Text:
        container = ttk.Frame(parent, style="Card.TFrame")
        container.pack(fill="both", expand=True)
        text = tk.Text(
            container,
            height=height,
            wrap="word",
            relief="flat",
            bg="#f6f9fc",
            fg="#243447",
            insertbackground="#243447",
            font=("Consolas", 10),
            padx=10,
            pady=8,
        )
        scrollbar = ttk.Scrollbar(container, command=text.yview)
        text.configure(yscrollcommand=scrollbar.set)
        text.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        return text

    def _identity_text(self) -> str:
        return f"学号：{self.config_data['student_id']}    姓名：{self.config_data['student_name']}"

    def save_identity(self) -> None:
        student_id = self.student_id_var.get().strip()
        student_name = self.student_name_var.get().strip()
        if not student_id or not student_name:
            messagebox.showwarning("学生信息", "学号和姓名不能为空。")
            return
        self.config_data = {"student_id": student_id, "student_name": student_name}
        try:
            CONFIG_FILE.write_text(json.dumps(self.config_data, ensure_ascii=False, indent=2), encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("保存失败", str(exc))
            return
        self.title(self._window_title())
        self.header_identity.configure(text=self._identity_text())
        self._append_log(self.send_text, f"待发送学号已更新：{student_id}")
        self.status_var.set("学生信息已保存，窗口标题已更新")

    def refresh_ports(self) -> None:
        if list_ports is None:
            ports: list[str] = []
        else:
            ports = [port.device for port in list_ports.comports()]
        self.port_box["values"] = ports
        if ports and self.port_var.get() not in ports:
            self.port_var.set(ports[0])
            self.status_var.set(f"检测到 {len(ports)} 个串口")
        elif not ports:
            self.port_var.set("")
            self.status_var.set("未检测到串口，请连接 Arduino 后刷新")

    def toggle_connection(self) -> None:
        if self.worker.is_open:
            self._disconnect()
            return
        port = self.port_var.get()
        if not port:
            messagebox.showwarning("打开串口", "未选择串口，请连接 Arduino 后点击刷新。")
            return
        try:
            self.worker.open(port, int(self.baud_var.get()))
        except (ValueError, RuntimeError, OSError) as exc:
            messagebox.showerror("串口打开失败", str(exc))
            return
        except Exception as exc:
            messagebox.showerror("串口打开失败", str(exc))
            return
        self.connection_button.configure(text="关闭串口")
        self.port_box.configure(state="disabled")
        self.status_dot.configure(fg="#0f9d58")
        self.status_var.set(f"已连接 {port}，波特率 {self.baud_var.get()}")

    def _disconnect(self) -> None:
        self.worker.close()
        self.connection_button.configure(text="打开串口")
        self.port_box.configure(state="readonly")
        self.status_dot.configure(fg="#8b99a8")
        self.status_var.set("串口已关闭")

    def send_student_id(self) -> None:
        student_id = self.student_id_var.get().strip()
        if not student_id or student_id == DEFAULT_CONFIG["student_id"]:
            messagebox.showwarning("发送学号", "请先填写并保存自己的学号。")
            return
        self._send(make_command("ID", student_id), f"发送学号：{student_id}")

    def send_command(self, command: str, label: str) -> None:
        self._send(make_command(command), f"控制命令：{label} ({command})")

    def _send(self, payload: bytes, log_message: str) -> None:
        try:
            self.worker.send(payload)
        except (RuntimeError, OSError) as exc:
            messagebox.showwarning("发送失败", str(exc))
            return
        except Exception as exc:
            messagebox.showerror("发送失败", str(exc))
            return
        self._append_log(self.send_text, log_message)
        self.status_var.set("数据发送成功")

    def _process_inbox(self) -> None:
        try:
            while True:
                kind, payload = self.inbox.get_nowait()
                if kind == "data":
                    self._handle_received(str(payload))
                elif kind == "error":
                    self._append_log(self.receive_text, f"[串口错误] {payload}")
                    self._disconnect()
                    messagebox.showerror("串口通信中断", str(payload))
        except queue.Empty:
            pass
        self.after(self.POLL_INTERVAL_MS, self._process_inbox)

    def _handle_received(self, message: str) -> None:
        parsed = parse_distance(message)
        if parsed:
            value, unit = parsed
            self.distance_var.set(f"{value:g} {unit}")
            self._append_log(self.receive_text, f"距离：{value:g} {unit}    原始数据：{message}")
            self.status_var.set("已接收距离数据")
        else:
            self._append_log(self.receive_text, f"消息：{message}")

    @staticmethod
    def _append_log(widget: tk.Text, message: str) -> None:
        timestamp = datetime.now().strftime("%H:%M:%S")
        widget.insert("end", f"[{timestamp}] {message}\n")
        widget.see("end")

    @staticmethod
    def _clear_text(widget: tk.Text) -> None:
        widget.delete("1.0", "end")

    @staticmethod
    def _load_config() -> dict[str, str]:
        try:
            data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            return {
                "student_id": str(data.get("student_id") or DEFAULT_CONFIG["student_id"]),
                "student_name": str(data.get("student_name") or DEFAULT_CONFIG["student_name"]),
            }
        except (OSError, json.JSONDecodeError, TypeError):
            return DEFAULT_CONFIG.copy()

    def _on_close(self) -> None:
        self.worker.close()
        self.destroy()


if __name__ == "__main__":
    ArduinoSerialApp().mainloop()
